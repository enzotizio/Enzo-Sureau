# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# Brevo (emails transactionnels) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Adresse expéditrice, doit être validée dans Brevo (domaine ou adresse authentifiée)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="GL Paysage"

# Adresse qui reçoit les notifications de nouvelles demandes de devis.
# Optionnel : par défaut, utilise siteConfig.email (src/lib/site-config.ts).
DEVIS_NOTIFICATION_EMAIL=

# Google Places (autocomplétion d'adresse dans le formulaire de devis).
# Optionnel : sans clé, le champ adresse reste utilisable en saisie libre.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
